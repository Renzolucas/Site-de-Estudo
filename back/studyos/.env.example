# StudyOS - Variáveis de Ambiente do Backend Spring Boot
# Copie este arquivo para .env e preencha com seus dados locais ou do servidor

# Conexão com o Banco de Dados MySQL
DATABASE_URL=jdbc:mysql://localhost:3306/studyos?createDatabaseIfNotExist=true&serverTimezone=America/Sao_Paulo
DATA_USER=root
DATA_PASSWORD=sua_senha_aqui

# Segredo para assinatura dos tokens JWT (mínimo de 256 bits / 32 caracteres)
JWT_SECRET=coloque_uma_chave_secreta_aleatoria_longa_aqui_exemplo_abc123456789

# Tempo de expiração do Token JWT em dias (padrão: 7 dias)
JWT_EXPIRATION_DAYS=7
