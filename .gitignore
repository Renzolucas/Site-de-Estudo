# ==============================================================================
# Root .gitignore - StudyOS Monorepo (Frontend + Backend)
# ==============================================================================

# IDEs and Editors
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
.settings/
.classpath
.project
.factorypath
.apt_generated/
.springBeans
.sts4-cache/
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend Artifacts
**/node_modules/
**/dist/
**/build/
**/.cache/
**/.vite/
*.tsbuildinfo
.claude-replay.*
.tmp-*
/.plugins/
/.opencode-skills/

# Java / Maven Backend Artifacts
**/target/
**/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Temporary files
*.tmp
*.bak
